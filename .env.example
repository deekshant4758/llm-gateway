# Copy to .env and fill in. Never commit the real .env.
PORT=3000

# --- Provider keys ---
# Configure any subset of these. A provider is only added to the
# fallback chain if its key is present, so it's fine to fill in just
# one or two. Get free-tier keys at:
#   Groq:       https://console.groq.com/keys
#   Gemini:     https://aistudio.google.com/apikey
#   OpenRouter: https://openrouter.ai/settings/keys
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Order to try providers in, comma-separated. Providers with no API key
# set above are skipped automatically. If every configured provider
# fails, the API returns a retryable 503.
PROVIDER_ORDER=groq,gemini,openrouter

# Optional: override the default model used for each provider's cheap
# and capable tier (see PROVIDER_ORDER above and the router stretch
# goal in README/DECISIONS.md).
# GROQ_CHEAP_MODEL=qwen/qwen3.8-27b
# GROQ_CAPABLE_MODEL=openai/gpt-oss-120b
# GEMINI_CHEAP_MODEL=gemini-2.5-flash-lite
# GEMINI_CAPABLE_MODEL=gemini-2.5-flash
# OPENROUTER_CHEAP_MODEL=qwen/qwen3.8-27b:free
# OPENROUTER_CAPABLE_MODEL=qwen/qwen3.8-27b:free

# Optional attribution headers OpenRouter uses for its public rankings;
# harmless to leave blank.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=llm-gateway

# How long to wait on a provider before giving up and trying the next
# one in the chain (ms).
PROVIDER_TIMEOUT_MS=15000

# Where the SQLite file lives. Defaults to ./data/gateway.db
DB_PATH=./data/gateway.db
